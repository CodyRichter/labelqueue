# /etc/labelqueue/labelqueue.env (deploy.sh creates it from this file once, then leaves it alone)
# file = no printer, jobs land in /var/lib/labelqueue/out. Then rfcomm (classic BT) or ble.
LABELQUEUE_TRANSPORT=file
# Printer Bluetooth MAC, from `bluetoothctl devices`
LABELQUEUE_ADDRESS=
# rfcomm: SPP channel from `sdptool browse <mac>`
LABELQUEUE_RFCOMM_CHANNEL=1
# ble: writable characteristic UUID from bluetoothctl's gatt menu
LABELQUEUE_BLE_CHAR=
LABELQUEUE_BLE_CHUNK=180
# Label stock and print tuning (names: 4x6 4x3 3x2 2x3 2x1 2.25x1.25)
LABELQUEUE_DEFAULT_SIZE=4x6
LABELQUEUE_BINSIGHT_SIZE=2x3
LABELQUEUE_DENSITY=8
# Print speed in inches/s (e.g. 2). Slower makes large black areas darker; empty = printer default.
LABELQUEUE_SPEED=
LABELQUEUE_GAP_MM=2
LABELQUEUE_X_OFFSET=0
# Binsight (https://github.com/CodyRichter/binsight) base URL, e.g. http://binsight.local:8000. Empty = no Binsight tab.
BINSIGHT_URL=
